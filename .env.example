# Crewline — environment configuration
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Load with: node --env-file=.env src/server.js   (Node 20+)
# or use dotenv if you prefer.

# --- Telegram (PRIMARY channel — no business verification needed) ---
# 1. Telegram -> @BotFather -> /newbot -> copy the token.
# 2. TELEGRAM_WEBHOOK_SECRET: any random string you invent (A-Z a-z 0-9 _ -, up to 256 chars).
# 3. PUBLIC_BASE_URL: your public https URL. On Railway with a public domain it is
#    detected automatically (RAILWAY_PUBLIC_DOMAIN) and you can leave it blank.
# On boot the server registers its own webhook — there is no manual setWebhook step.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Bot username (without @) — used in the welcome message when a venue is created.
TELEGRAM_BOT_USERNAME=CrewLine_SuperApps_bot

# --- Meta / WhatsApp Cloud API (OPTIONAL fallback — leave blank to run Telegram-only) ---
# From developers.facebook.com -> your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# A string YOU invent, then enter the same value in the Meta dashboard
# when configuring the webhook (Webhooks -> Verify Token).
WHATSAPP_VERIFY_TOKEN=

# From developers.facebook.com -> your App -> App Settings -> Basic -> App Secret
META_APP_SECRET=

# --- Server ---
PORT=3000

# --- Firebase (build step 2 onward) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. It downloads a .json file — open it in any text editor,
# copy the ENTIRE contents, and paste as a single-line value here (Railway's
# variable editor handles the JSON fine, multi-line and all).
# Leave blank to run on in-memory stores (fine for early testing only —
# data resets every time the server restarts).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Multi-venue ---
# MANAGER_DASHBOARD_PASSWORD is the ADMIN key: it opens the venue below and the
# /api/admin routes that create new venues. Every other venue gets its own key.
MANAGER_DASHBOARD_PASSWORD=
ADMIN_TENANT_ID=demo-venue
